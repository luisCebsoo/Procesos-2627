# Solo NOMBRES de variables (cero secretos en el repo).
PORT=3000
BCRYPT_COST=10
# MongoDB: vacío = modo memoria (tests/CI). Para persistir, pega aquí
# tu URI real (Atlas o local) SOLO en tu .env, jamás commiteado:
#   Local: mongodb://localhost:27017/procesos2627
#   Atlas: mongodb+srv://USUARIO:CONTRASEÑA@CLUSTER/procesos2627
MONGODB_URI=
# Primer admin (PBI-6): al arrancar, se crea activo (o se asciende si
# existe). Sin ADMIN_EMAIL no se crea ninguno. Valores reales SOLO en
# tu .env o en el panel Environment de Render, jamás commiteados.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Correo transaccional (PBI-7): cualquier SMTP (Brevo, SendGrid...).
# Sin estas 4, el enlace se registra en el log (modo desarrollo/CI).
# En Render free el SMTP directo está bloqueado: usa servicio externo
# y revisa el spam. APP_URL es la base absoluta de los enlaces.
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# OAuth GitHub (PBI-8): crea una OAuth App en GitHub (Settings >
# Developer settings) y registra ESTAS DOS callback URL exactas:
#   http://localhost:3000/api/auth/oauth/github/callback
#   https://TU-APP.onrender.com/api/auth/oauth/github/callback
# Sin estas 3, el botón da 501. Secretos solo aquí o en Render.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/oauth/github/callback
